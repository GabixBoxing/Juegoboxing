<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>🏆 TORNEO CUBAN BOXING - 5 PELEAS</title>
    <style>
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }
        body {
            margin: 0;
            min-height: 100vh;
            background: radial-gradient(circle at 20% 30%, #1a1a2a, #0a0a14);
            font-family: 'Barlow Condensed', 'Impact', 'Arial Black', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 16px;
        }
        .tournament-container {
            max-width: 600px;
            width: 100%;
            background: #0f0f1c;
            border-radius: 56px;
            padding: 20px 16px;
            border: 2px solid #D4A017;
            box-shadow: 0 20px 35px black;
        }
        .header {
            text-align: center;
            margin-bottom: 16px;
        }
        .title {
            font-size: 28px;
            font-weight: 900;
            background: linear-gradient(135deg, #D4A017, #fff);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        .fight-card {
            background: #1e1e2e;
            border-radius: 32px;
            padding: 16px;
            margin-bottom: 16px;
            text-align: center;
        }
        .versus {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin: 12px 0;
        }
        .boxer {
            flex: 1;
            background: #05050f;
            border-radius: 28px;
            padding: 12px;
        }
        .boxer-name {
            font-size: 20px;
            font-weight: 900;
        }
        .health-bar-bg {
            background: #2a1a1a;
            border-radius: 20px;
            height: 16px;
            margin: 8px 0;
        }
        .health-fill {
            width: 100%;
            height: 100%;
            background: #27ae60;
            border-radius: 20px;
            transition: width 0.2s;
        }
        .hp-text {
            font-size: 12px;
        }
        .vs {
            font-size: 28px;
            font-weight: 900;
            color: #D4A017;
        }
        .actions {
            display: flex;
            gap: 12px;
            margin: 16px 0;
        }
        .punch-btn {
            flex: 1;
            background: #2c2c3a;
            border: none;
            border-radius: 60px;
            padding: 12px;
            font-weight: 900;
            font-size: 18px;
            color: white;
            box-shadow: 0 4px 0 #0a0a12;
            cursor: pointer;
            transition: 0.05s linear;
            border-bottom: 2px solid #D4A017;
        }
        .punch-btn:active {
            transform: translateY(3px);
            box-shadow: 0 1px 0 #0a0a12;
        }
        .btn-jab { background: #1e4a6e; }
        .btn-hook { background: #8b4a1a; }
        .btn-upper { background: #6b1a2a; }
        .next-btn {
            background: #D4A017;
            color: #0a0a12;
            width: 100%;
            margin-top: 12px;
        }
        .message {
            background: #000000aa;
            backdrop-filter: blur(4px);
            border-radius: 40px;
            padding: 10px;
            text-align: center;
            font-size: 14px;
            margin-top: 12px;
        }
        .belt-area {
            text-align: center;
            margin-top: 20px;
            background: linear-gradient(145deg, #1a1a2a, #0f0f1c);
            border-radius: 48px;
            padding: 20px;
            border: 2px solid #D4A017;
        }
        .belt-title {
            font-size: 24px;
            font-weight: 900;
            color: #D4A017;
        }
        canvas {
            display: block;
            margin: 10px auto;
            background: #0a0a1a;
            border-radius: 24px;
            max-width: 100%;
            height: auto;
        }
        .winner-badge {
            font-size: 32px;
            font-weight: 900;
            color: #f1c40f;
            text-shadow: 2px 2px 0 #8b6e0e;
        }
        button:disabled {
            opacity: 0.5;
            transform: none;
        }
        @media (max-width: 480px) {
            .boxer-name { font-size: 16px; }
            .punch-btn { font-size: 14px; padding: 10px; }
            .vs { font-size: 22px; }
        }
    </style>
</head>
<body>
<div class="tournament-container" id="app">
    <!-- Panel dinámico -->
</div>

<script>
    // ---------- DATOS DEL TORNEO ----------
    const rivals = [
        { name: "RIVAL 1 · JAB LENTO",   hp: 80,  baseDamage: 7,  critChance: 0.1, phrase: "Principiante" },
        { name: "RIVAL 2 · GOLPE FIJO",  hp: 90,  baseDamage: 9,  critChance: 0.15, phrase: "Aficionado" },
        { name: "RIVAL 3 · PRESIÓN",     hp: 100, baseDamage: 11, critChance: 0.2,  phrase: "Experimentado" },
        { name: "RIVAL 4 · FEROZ",       hp: 110, baseDamage: 13, critChance: 0.25, phrase: "Duro" },
        { name: "RIVAL 5 · CAMPEÓN",     hp: 130, baseDamage: 15, critChance: 0.3,  phrase: "Titán" }
    ];
    
    let currentFight = 0;          // 0..4
    let player = { name: "", hp: 100, maxHp: 100 };
    let enemy = null;
    let fightActive = true;
    let canAttack = true;
    let fightResult = null; // "win" or "lose"
    let tournamentWon = false;
    
    // Elementos del DOM (se actualizan dinámicamente)
    let appDiv;
    
    // Funciones de utilidad
    function showMessage(msg, isError = false) {
        const msgDiv = document.getElementById('fightMessage');
        if (msgDiv) {
            msgDiv.innerText = msg;
            msgDiv.style.color = isError ? '#e74c3c' : '#f1c40f';
            setTimeout(() => {
                if (msgDiv && !fightActive && document.getElementById('fightMessage') === msgDiv) {
                    if (!tournamentWon && currentFight < rivals.length) 
                        msgDiv.innerText = "⚡ Presiona SIGUIENTE PELEA";
                    else if (tournamentWon) msgDiv.innerText = "🏆 ¡CAMPEÓN ABSOLUTO! 🏆";
                }
            }, 1800);
        }
    }
    
    function updateUI() {
        if (!appDiv) return;
        const playerHpPercent = (player.hp / player.maxHp) * 100;
        const enemyHpPercent = enemy ? (enemy.hp / enemy.maxHp) * 100 : 0;
        document.getElementById('playerHpFill').style.width = `${Math.max(0, playerHpPercent)}%`;
        document.getElementById('playerHpText').innerText = `${Math.floor(player.hp)}%`;
        if (enemy) {
            document.getElementById('enemyHpFill').style.width = `${Math.max(0, enemyHpPercent)}%`;
            document.getElementById('enemyHpText').innerText = `${Math.floor(enemy.hp)}%`;
        }
        // Cambiar color si está bajo
        const pFill = document.getElementById('playerHpFill');
        if (playerHpPercent < 30) pFill.style.background = "#e74c3c";
        else pFill.style.background = "#27ae60";
        if (enemy && enemy.hp / enemy.maxHp < 0.3) {
            document.getElementById('enemyHpFill').style.background = "#e74c3c";
        } else if (enemy) {
            document.getElementById('enemyHpFill').style.background = "#27ae60";
        }
    }
    
    // Ataque del jugador
    function playerAttack(type) {
        if (!fightActive || !canAttack || tournamentWon) {
            showMessage("La pelea ya terminó o no es tu turno", true);
            return;
        }
        if (player.hp <= 0 || enemy.hp <= 0) return;
        
        const punches = {
            jab:   { base: 9,  critMult: 1.4, name: "JAB" },
            hook:  { base: 14, critMult: 1.5, name: "GANCHO" },
            upper: { base: 19, critMult: 1.7, name: "UPPERCUT" }
        };
        let punch = punches[type];
        let damage = punch.base + Math.floor(Math.random() * 5) - 2;
        damage = Math.max(6, damage);
        let isCrit = Math.random() < 0.2;
        if (isCrit) damage = Math.floor(damage * punch.critMult);
        
        let newEnemyHp = enemy.hp - damage;
        enemy.hp = Math.max(0, newEnemyHp);
        showMessage(`💥 ¡${punch.name}! -${damage} HP ${isCrit ? "CRÍTICO" : ""}`);
        updateUI();
        
        if (enemy.hp <= 0) {
            fightActive = false;
            showMessage(`🎉 ¡DERRIBASTE A ${enemy.name}! 🎉`);
            fightResult = "win";
            disableAttackButtons(true);
            document.getElementById('nextFightBtn').disabled = false;
            return;
        }
        
        // Turno de la IA (contraataque)
        canAttack = false;
        setTimeout(() => {
            if (fightActive && player.hp > 0 && enemy.hp > 0) {
                enemyAttack();
            }
            canAttack = true;
        }, 600);
    }
    
    function enemyAttack() {
        if (!fightActive || player.hp <= 0) return;
        let damage = enemy.baseDamage + Math.floor(Math.random() * 5) - 2;
        damage = Math.max(5, damage);
        let isCrit = Math.random() < enemy.critChance;
        if (isCrit) damage = Math.floor(damage * 1.5);
        let newPlayerHp = player.hp - damage;
        player.hp = Math.max(0, newPlayerHp);
        showMessage(`😠 ${enemy.name} contraataca: -${damage} HP ${isCrit ? "¡CRÍTICO!" : ""}`, true);
        updateUI();
        
        if (player.hp <= 0) {
            fightActive = false;
            fightResult = "lose";
            showMessage(`😵 ¡KNOCKOUT! Perdiste contra ${enemy.name}`, true);
            disableAttackButtons(true);
            document.getElementById('nextFightBtn').disabled = false;
            document.getElementById('nextFightBtn').innerText = "🔁 REINICIAR TORNEO";
        }
    }
    
    function disableAttackButtons(disabled) {
        const btns = ['jabBtn', 'hookBtn', 'upperBtn'];
        btns.forEach(id => {
            let btn = document.getElementById(id);
            if (btn) btn.disabled = disabled;
        });
    }
    
    // Cargar siguiente pelea o reiniciar torneo
    function nextFight() {
        if (tournamentWon) {
            resetTournament();
            return;
        }
        if (fightResult === "lose") {
            resetTournament();
            return;
        }
        if (fightResult === "win") {
            currentFight++;
            if (currentFight >= rivals.length) {
                // TORNEO COMPLETADO -> CINTURÓN
                tournamentWon = true;
                renderBeltScreen();
                return;
            } else {
                loadFight(currentFight);
            }
        } else {
            // Si no hay resultado, no debe pasar
            if (!fightActive && player.hp > 0 && enemy && enemy.hp <= 0) {
                currentFight++;
                if (currentFight >= rivals.length) {
                    tournamentWon = true;
                    renderBeltScreen();
                } else {
                    loadFight(currentFight);
                }
            }
        }
    }
    
    function loadFight(index) {
        const rivalData = { ...rivals[index] };
        enemy = {
            name: rivalData.name,
            hp: rivalData.hp,
            maxHp: rivalData.hp,
            baseDamage: rivalData.baseDamage,
            critChance: rivalData.critChance
        };
        player.hp = player.maxHp; // Recupera vida completa entre peleas
        fightActive = true;
        fightResult = null;
        canAttack = true;
        disableAttackButtons(false);
        renderFightScreen();
        showMessage(`🥊 PELEA ${index+1} DE ${rivals.length} VS ${enemy.name}`, false);
    }
    
    function resetTournament() {
        currentFight = 0;
        player.hp = player.maxHp;
        tournamentWon = false;
        fightResult = null;
        loadFight(0);
    }
    
    // Pantalla de pelea
    function renderFightScreen() {
        appDiv.innerHTML = `
            <div class="header"><div class="title">🇨🇺 TORNEO CUBAN BOXING 🇨🇺</div></div>
            <div class="fight-card">
                <div class="versus">
                    <div class="boxer">
                        <div class="boxer-name">🥊 ${player.name}</div>
                        <div class="health-bar-bg"><div id="playerHpFill" class="health-fill" style="width:100%"></div></div>
                        <div id="playerHpText" class="hp-text">100%</div>
                    </div>
                    <div class="vs">VS</div>
                    <div class="boxer">
                        <div class="boxer-name">🥊 ${enemy ? enemy.name : "RIVAL"}</div>
                        <div class="health-bar-bg"><div id="enemyHpFill" class="health-fill" style="width:100%"></div></div>
                        <div id="enemyHpText" class="hp-text">${enemy ? enemy.hp : 100}%</div>
                    </div>
                </div>
                <div class="actions">
                    <button class="punch-btn btn-jab" id="jabBtn">🤜 JAB</button>
                    <button class="punch-btn btn-hook" id="hookBtn">👊 GANCHO</button>
                    <button class="punch-btn btn-upper" id="upperBtn">💥 UPPERCUT</button>
                </div>
                <button class="punch-btn next-btn" id="nextFightBtn">➡️ SIGUIENTE PELEA</button>
                <div id="fightMessage" class="message">⚡ ¡PELEA! ATACA CON UN GOLPE</div>
            </div>
        `;
        // Asignar eventos después de renderizar
        document.getElementById('jabBtn').addEventListener('click', () => playerAttack('jab'));
        document.getElementById('hookBtn').addEventListener('click', () => playerAttack('hook'));
        document.getElementById('upperBtn').addEventListener('click', () => playerAttack('upper'));
        document.getElementById('nextFightBtn').addEventListener('click', () => nextFight());
        disableAttackButtons(false);
        if (!fightActive) document.getElementById('nextFightBtn').disabled = false;
        updateUI();
    }
    
    // Pantalla de campeón con cinturón y dibujo
    function renderBeltScreen() {
        appDiv.innerHTML = `
            <div class="header"><div class="title">🏆 CAMPEÓN DEL TORNEO 🏆</div></div>
            <div class="belt-area">
                <div class="belt-title">🥊 CINTURÓN CUBAN BOXING 🥊</div>
                <canvas id="champCanvas" width="400" height="300" style="width:100%; height:auto; max-width:400px; background:#0a0a1a; border-radius:24px; margin:10px auto; display:block"></canvas>
                <div class="winner-badge">${player.name.toUpperCase()} · BOXEADOR GANADOR</div>
                <div style="margin-top:16px; font-size:16px;">✨ ¡HISTORIA PURA! ✨</div>
                <button class="punch-btn next-btn" id="restartTourney" style="margin-top:20px;">🔄 JUGAR DE NUEVO</button>
            </div>
        `;
        drawChampionCanvas(player.name);
        document.getElementById('restartTourney').addEventListener('click', () => {
            resetTournament();
        });
    }
    
    // Dibujo de boxeador cubano con cinturón
    function drawChampionCanvas(name) {
        const canvas = document.getElementById('champCanvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        const w = canvas.width, h = canvas.height;
        ctx.clearRect(0, 0, w, h);
        
        // Fondo estilo bandera cubana
        ctx.fillStyle = "#0a1c3a";
        ctx.fillRect(0, 0, w, h);
        ctx.fillStyle = "#c0392b";
        ctx.fillRect(0, 0, w, 25);
        ctx.fillStyle = "#ffffff";
        ctx.fillRect(0, 50, w, 25);
        ctx.fillStyle = "#c0392b";
        ctx.fillRect(0, 100, w, 25);
        ctx.fillStyle = "#1a4a7a";
        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.lineTo(80, 0);
        ctx.lineTo(80, 125);
        ctx.lineTo(0, 125);
        ctx.fill();
        ctx.fillStyle = "#fff";
        ctx.font = "bold 20px 'Barlow Condensed'";
        ctx.fillText("★ CUBA ★", 10, 85);
        
        // Boxeador
        ctx.fillStyle = "#f7cf9f";
        ctx.beginPath();
        ctx.arc(w/2, 150, 35, 0, Math.PI*2);
        ctx.fill();
        ctx.fillStyle = "#D4A017";
        ctx.beginPath();
        ctx.ellipse(w/2, 120, 30, 18, 0, 0, Math.PI*2);
        ctx.fill();
        ctx.fillStyle = "#000";
        ctx.beginPath();
        ctx.arc(w/2-12, 140, 5, 0, Math.PI*2);
        ctx.arc(w/2+12, 140, 5, 0, Math.PI*2);
        ctx.fill();
        ctx.fillStyle = "white";
        ctx.beginPath();
        ctx.arc(w/2-14, 138, 2, 0, Math.PI*2);
        ctx.arc(w/2+10, 138, 2, 0, Math.PI*2);
        ctx.fill();
        // Cuerpo y guantes
        ctx.fillStyle = "#2c5282";
        ctx.fillRect(w/2-25, 175, 50, 55);
        ctx.fillStyle = "#c0392b";
        ctx.beginPath();
        ctx.ellipse(w/2-35, 190, 16, 22, -0.3, 0, Math.PI*2);
        ctx.fill();
        ctx.beginPath();
        ctx.ellipse(w/2+35, 190, 16, 22, 0.3, 0, Math.PI*2);
        ctx.fill();
        // Cinturón
        ctx.fillStyle = "#D4A017";
        ctx.fillRect(w/2-30, 210, 60, 15);
        ctx.fillStyle = "#8b6e0e";
        ctx.fillRect(w/2-20, 212, 40, 11);
        ctx.fillStyle = "#e74c3c";
        ctx.font = "bold 14px 'Barlow Condensed'";
        ctx.fillText("CHAMP", w/2-25, 224);
        // Texto nombre
        ctx.font = "bold 18px 'Barlow Condensed'";
        ctx.fillStyle = "#D4A017";
        ctx.fillText(name.toUpperCase(), w/2-55, 260);
        ctx.fillStyle = "#fff";
        ctx.font = "italic 12px sans-serif";
        ctx.fillText("CUBAN BOXING LEGEND", w/2-75, 285);
    }
    
    // Inicialización: pedir nombre del boxeador
    function startTournament() {
        appDiv = document.getElementById('app');
        let playerName = prompt("🇨🇺 ¡BOXEO CUBANO! 🇨🇺\nIngresa el nombre de tu boxeador:", "El Titan");
        if (!playerName) playerName = "CAMPEÓN";
        player.name = playerName;
        player.maxHp = 100;
        player.hp = 100;
        currentFight = 0;
        tournamentWon = false;
        loadFight(0);
    }
    
    startTournament();
</script>
</body>
</html>
